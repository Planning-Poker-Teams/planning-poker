{
  "name": "backend",
  "version": "0.1.0",
  "licenses": [
    {
      "type": "MIT"
    }
  ],
  "scripts": {
    "build": "esbuild src/handlers/handleWebsocketEvents.ts src/handlers/preventClientTimeout.ts --outdir=dist --platform=node --target=node24 --loader:.ts=ts --bundle",
    "test": "DEBUG=testcontainers vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "feature": "cucumber-js --require-module ts-node/register/transpile-only --require src/__features__/support/setup.ts --require 'src/__features__/support/*Steps.ts'",
    "features": "yarn feature src/__features__/"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.2",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "expect": "^30.3.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "testcontainers": "^11.14.0",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1042.0",
    "@aws-sdk/client-dynamodb": "^3.1042.0",
    "@aws-sdk/lib-dynamodb": "^3.1042.0",
    "aws-xray-sdk-core": "^3.12.0",
    "lambda-log": "^3.1.0"
  }
